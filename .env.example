# Copy to .env and edit. Everything here is optional — with no .env at all you
# get the kokoro-only stack, default voices, no authentication, no quiet hours,
# and the dashboard on http://127.0.0.1:8899/.
#
# Every variable may be left blank: compose always passes it through, so the
# server reads an empty value as "unset" and applies its own default.

# ---------------------------------------------------------------------------
# Host and container
# ---------------------------------------------------------------------------

# Run the container as the desktop user who owns the audio session
# (defaults to 1000; check with `id -u`).
#UID=1000
#GID=1000

# Rootless podman only. Without it, container uid 1000 is a subuid on the host
# and can't read the Pulse cookie, so playback fails to authenticate. Leave
# unset under Docker — it only accepts "host" here.
#USERNS_MODE=keep-id

# Which host interface port 8899 is published on. The default reaches the whole
# LAN, which is the point; narrow it to one address, or to 127.0.0.1, if you'd
# rather use a firewall or an SSH tunnel.
#SPEAK_BIND=0.0.0.0

# Container timezone. Quiet hours use it unless QUIET_HOURS_TZ overrides.
#TZ=Europe/London

#LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Engines and voices
# ---------------------------------------------------------------------------

# Enable the supertonic engine (adds the supertonic container; requires the
# model assets — see README).
#COMPOSE_PROFILES=supertonic

# Engine used when a request doesn't name one:
#   kokoro | supertonic | fastest | random
# `fastest` picks whichever engine has been fastest lately (measured, not
# configured); `random` picks one at random. Both fall through to the next
# engine if their pick fails.
#ENGINE=kokoro

# Default voice per engine — voice names are not shared between engines.
#VOICE=af_heart
#SUPERTONIC_VOICE=M1

# Synthesis request timeout, and how many recent runs feed the `fastest`
# ranking. After ENGINE_FAILURE_THRESHOLD consecutive failures an engine is
# skipped by automatic selection for ENGINE_COOLDOWN seconds.
#SYNTH_TIMEOUT=120
#LATENCY_WINDOW=10
#ENGINE_FAILURE_THRESHOLD=3
#ENGINE_COOLDOWN=60

# ---------------------------------------------------------------------------
# Priority, queue and interruption
# ---------------------------------------------------------------------------

# Priority levels, most to least important: emergency, high, normal, low.
# Requests may name one; this is used when they don't.
#DEFAULT_PRIORITY=normal

# Queue depth, and how long an utterance may wait before it's dropped as stale
# ("build started" is noise once the build has finished). A full queue drops its
# least important item rather than rejecting the new one. 0 disables expiry.
#QUEUE_MAX=100
#QUEUE_ITEM_TTL=300

# Whether a more important utterance may cut off one already playing, and by how
# many levels it has to outrank it (1 = high interrupts normal). INTERRUPT_REQUEUE
# says the interrupted utterance is spoken again afterwards instead of dropped.
#INTERRUPT=1
#INTERRUPT_MIN_GAP=1
#INTERRUPT_REQUEUE=0

# Longest text accepted in one request, in characters.
#MAX_TEXT=5000

# ---------------------------------------------------------------------------
# Quiet hours
# ---------------------------------------------------------------------------

# Windows in which unimportant speech is held back. HH:MM-HH:MM, may wrap past
# midnight, comma-separate several. Unset means no quiet hours.
#QUIET_HOURS=23:00-07:30
#QUIET_HOURS_TZ=Europe/London

# What happens to speech that arrives during a window and doesn't outrank the
# override level:
#   defer     — spoken when the window ends (the default)
#   drop      — thrown away, and the caller is told
#   attenuate — spoken now at QUIET_HOURS_VOLUME
#QUIET_HOURS_POLICY=defer
#QUIET_HOURS_OVERRIDE=emergency
# The volume scale is cubic, like a desktop slider: 60 is about -13 dB (clearly
# quieter, still audible), while 25 is -36 dB (effectively silent).
#QUIET_HOURS_VOLUME=60

# ---------------------------------------------------------------------------
# Audio routing and playback
# ---------------------------------------------------------------------------

# Output device used when a request doesn't name one. Blank means the session
# default sink. List devices with: docker compose exec speak-server pactl list short sinks
#AUDIO_SINK=

# Friendly names for sinks, so clients say {"sink": "kitchen"} instead of pasting
# a device name that changes when hardware moves.
#AUDIO_ROUTES=desk=alsa_output.pci-0000_00_1f.3.analog-stereo,tv=alsa_output.hdmi-stereo

# Default volume, 0-100. Requests may ask for less; quiet hours can force less.
#VOLUME=100

# Silence prepended to every clip so the audio sink's resume-from-idle ramp
# doesn't clip the first syllable. 0 to disable.
#LEAD_SILENCE_MS=500
#PLAY_TIMEOUT=600

# ---------------------------------------------------------------------------
# Voice cache, history and dashboard
# ---------------------------------------------------------------------------

# Synthesized audio is cached on disk under ./data, keyed by engine, voice,
# speed and text, so repeated phrases ("tests passed") replay instantly and
# cost nothing. Text longer than CACHE_MAX_TEXT is never cached — it wouldn't
# be asked for twice and would evict the phrases that are.
#CACHE_ENABLED=1
#CACHE_MAX_MB=512
#CACHE_MAX_AGE_DAYS=30
#CACHE_MAX_TEXT=400

# Every utterance is logged to ./data/history.db with its timings and outcome.
# HISTORY_KEEP_AUDIO also keeps a copy of anything the cache didn't, so the
# dashboard can replay every row rather than only some.
#HISTORY_ENABLED=1
#HISTORY_MAX_ROWS=5000
#HISTORY_MAX_AGE_DAYS=30
#HISTORY_KEEP_AUDIO=1
#HISTORY_AUDIO_MAX_MB=256

# The dashboard at http://<host>:8899/ — live queue, controls, engine health and
# a searchable history with playback. Set 0 to serve the API only.
#DASHBOARD=1

# ---------------------------------------------------------------------------
# Authentication and rate limits
# ---------------------------------------------------------------------------

# Named tokens, `name=secret` comma-separated. Setting any of them turns
# authentication on — there is no second switch to forget. The name is what the
# dashboard and history show, so one client can be revoked on its own.
#SPEAK_TOKENS=laptop=Xk9...,ci=Qp2...,hass=Rt7...

# Single-token shorthand, recorded as the client name "default".
#SPEAK_TOKEN=

# Callers from these networks skip authentication, so a shell on this host keeps
# working once tokens are on. Loopback alone would not achieve that in a
# container: published ports are NAT'd, so a local caller arrives as the compose
# bridge gateway and 127.0.0.1 is never seen. The server therefore detects that
# gateway and exempts it too — which also exempts anything else on this host
# reaching the published port through it. It logs the address at startup.
#
# Setting this yourself replaces that entirely and is used verbatim, so include
# the gateway if you still want local callers exempt — take the address from the
# startup log rather than the example below, which is only a shape. Compose
# numbers bridge networks per project, so yours will differ. To require a token
# even locally, set the word `none` — a blank value means "unset" here as
# everywhere, so it would just restore the default.
#AUTH_EXEMPT_CIDRS=127.0.0.0/8,::1/128,10.x.y.1/32
#AUTH_EXEMPT_CIDRS=none

# Token bucket, `requests/seconds`: a burst up to the count is allowed, then it
# refills. Blank disables it. Emergency-priority speech is never rate limited.
#RATE_LIMIT=60/60
#RATE_LIMIT_EXEMPT_PRIORITY=emergency

# ---------------------------------------------------------------------------
# MQTT bridge (optional)
# ---------------------------------------------------------------------------

# With a host set, the server subscribes to speak/say (plain text or the same
# JSON body as POST /speak), speak/say/<priority>, and speak/cmd/<action>, and
# publishes a retained snapshot on speak/status plus per-utterance events on
# speak/event. Home Assistant and Node-RED can drive it in one line.
#MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_TLS=0
#MQTT_CLIENT_ID=speak-server
#MQTT_TOPIC=speak/say
#MQTT_STATUS_TOPIC=speak/status
#MQTT_EVENT_TOPIC=speak/event
#MQTT_QOS=1

# ---------------------------------------------------------------------------
# Webhook receivers (optional)
# ---------------------------------------------------------------------------

# JSON file defining POST /webhook/<name> endpoints that turn somebody else's
# payload (GitHub, Alertmanager, Grafana, Uptime Kuma…) into a spoken sentence.
# See examples/webhooks.json and the README.
#WEBHOOKS_FILE=/data/webhooks.json
